rules_version = '2';

// Isolamento por dono (Fase 1 do plano de próximos passos, issue #31).
// Estado anterior: docs/security/firestore-rules-deployed.md e o histórico
// do git deste arquivo. Testes: tool/firestore-rules/ (Firestore Emulator,
// rodam no CI). Documentação: docs/security/firestore-isolamento-por-dono.md.
//
// O que mudou em relação à FASE 11:
//   - Saiu o catch-all `/{document=**}`. Ele tinha `allow write` para
//     qualquer usuário logado e também casava `Usuarios/{id}` e `Pets/{id}`,
//     então as condições de dono desses blocos não tinham efeito. Sem ele,
//     qualquer caminho sem regra própria abaixo é negado.
//   - `Usuarios`: só o próprio usuário (ID do documento = Auth UID) lê e
//     escreve o seu perfil.
//   - `Pets` e subcoleções: só o dono (`userId` = Auth UID) lê e escreve.
//   - Pet falecido: sem criar ou alterar registros clínicos; leitura e
//     exclusão continuam (exclusão de conta precisa apagar).
//   - `eventosSituacao`: só criação pelo dono, junto com a mudança real de
//     situação do pet; nunca alterado nem apagado.
//
// Pegadinhas que continuam valendo (aprendidas na FASE 11):
//   - Blocos `match` somam por OR: um `if false` não vence outra regra que
//     também case o mesmo caminho. Por isso nada aqui é genérico.
//   - Condição com erro (campo inexistente, `get` de documento que não
//     existe) vale `false`. Em `||`, um lado com erro não impede o outro
//     lado de liberar.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    // Dono de um documento de pet. `userId` é o campo de todos os pets
    // atuais; `userID` (D maiúsculo) só existe num pet legado de teste.
    function ehDonoDoPet(dados) {
      return dados.userId == request.auth.uid
          || dados.get('userID', null) == request.auth.uid;
    }

    match /Usuarios/{userId} {
      allow read, create, update, delete:
          if logado() && request.auth.uid == userId;
    }

    match /Pets/{petId} {
      allow read, delete: if logado() && ehDonoDoPet(resource.data);
      allow create: if logado()
          && request.resource.data.userId == request.auth.uid;
      // O pet continua sendo do mesmo tutor depois do update: não dá para
      // transferir para outra conta.
      allow update: if logado()
          && ehDonoDoPet(resource.data)
          && ehDonoDoPet(request.resource.data);

      function pet() {
        return get(/databases/$(database)/documents/Pets/$(petId));
      }
      function situacaoAntes() {
        return pet().data.get('situacao', 'ATIVO');
      }
      function situacaoDepois() {
        return getAfter(/databases/$(database)/documents/Pets/$(petId))
            .data.get('situacao', 'ATIVO');
      }
      function donoDoPet() {
        return logado() && ehDonoDoPet(pet().data);
      }
      // Escrita clínica = criar ou alterar vacina, consulta, histórico ou
      // localização. Bloqueada para pet falecido (ADR 0002).
      function podeEscreverClinico() {
        return donoDoPet() && situacaoAntes() != 'FALECIDO';
      }

      match /vacinas/{id} {
        allow read, delete: if donoDoPet();
        allow create, update: if podeEscreverClinico();
      }
      match /consultas/{id} {
        allow read, delete: if donoDoPet();
        allow create, update: if podeEscreverClinico();
      }
      match /historicoMedico/{id} {
        allow read, delete: if donoDoPet();
        allow create, update: if podeEscreverClinico();
      }
      match /localizacoes/{id} {
        allow read, delete: if donoDoPet();
        allow create, update: if podeEscreverClinico();
      }

      // Auditoria das mudanças de situação (Memorial). O evento só é aceito
      // na mesma escrita que muda `situacao` do pet, descrevendo exatamente
      // essa mudança, com o próprio usuário como autor e o horário do
      // servidor. Limite conhecido: o dono ainda pode mudar `situacao` sem
      // evento (update direto); auditoria à prova do próprio dono exigiria
      // servidor.
      match /eventosSituacao/{id} {
        allow read: if donoDoPet();
        allow create: if donoDoPet()
            && request.resource.data.keys().hasOnly([
                'atorId', 'situacaoAnterior', 'situacaoNova', 'motivo',
                'resultado', 'origem', 'em'])
            && request.resource.data.atorId == request.auth.uid
            && request.resource.data.em == request.time
            && request.resource.data.situacaoAnterior == situacaoAntes()
            && request.resource.data.situacaoNova == situacaoDepois()
            && situacaoAntes() != situacaoDepois();
        allow update, delete: if false;
      }
    }

    // Coleção raiz legada (95 registros históricos já migrados para o
    // MongoDB). Escrita fechada desde a FASE 11; leitura mantida para quem
    // está logado. Fechar a leitura é decisão pendente (ver doc acima).
    // MUTAÇÃO DE TESTE (não mesclar): catch-all da FASE 11 de volta.
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.path[3] != 'Localizacoes';
    }

    match /Localizacoes/{docId} {
      allow read: if logado();
      allow write: if false;
    }
  }
}
