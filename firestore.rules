rules_version = '2';

// Isolamento por dono (Fase 1 do plano de próximos passos, issue #31).
// Estado anterior: docs/security/firestore-rules-deployed.md e o histórico
// do git deste arquivo. Testes: tool/firestore-rules/ (Firestore Emulator,
// rodam no CI). Documentação: docs/security/firestore-isolamento-por-dono.md.
//
// O que mudou em relação à FASE 11:
//   - Saiu o catch-all `/{document=**}`. Ele tinha `allow write` para
//     qualquer usuário logado e também casava `Usuarios/{id}` e `Pets/{id}`,
//     então as condições de dono desses blocos não tinham efeito. Sem ele,
//     qualquer caminho sem regra própria abaixo é negado.
//   - `Usuarios`: só o próprio usuário (ID do documento = Auth UID) lê e
//     escreve o seu perfil.
//   - `Pets` e subcoleções: só o dono (`userId` = Auth UID) lê e escreve.
//   - Pet falecido: sem criar ou alterar registros clínicos; leitura e
//     exclusão continuam (exclusão de conta precisa apagar).
//   - `eventosSituacao`: só criação pelo dono, junto com a mudança real de
//     situação do pet; nunca alterado. Apagado só na escrita que apaga o
//     pet ou o perfil do dono (exclusão do pet ou da conta).
//   - `fotos` (galeria): só o dono, inclusive de pet falecido; criação
//     validada campo a campo, sem edição.
//
// Pegadinhas que continuam valendo (aprendidas na FASE 11):
//   - Blocos `match` somam por OR: um `if false` não vence outra regra que
//     também case o mesmo caminho. Por isso nada aqui é genérico.
//   - Condição com erro (campo inexistente, `get` de documento que não
//     existe) vale `false`. Em `||`, um lado com erro não impede o outro
//     lado de liberar.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    // Exclusão de conta: o perfil do próprio usuário existe antes desta
    // escrita e não existe depois, ou seja, é apagado nela (lote do app).
    function apagandoOProprioPerfil() {
      return exists(/databases/$(database)/documents/Usuarios/$(request.auth.uid))
          && !existsAfter(/databases/$(database)/documents/Usuarios/$(request.auth.uid));
    }

    // Dono de um documento de pet. `userId` é o campo de todos os pets
    // atuais; `userID` (D maiúsculo) só existe num pet legado de teste.
    function ehDonoDoPet(dados) {
      return dados.userId == request.auth.uid
          || dados.get('userID', null) == request.auth.uid;
    }

    match /Usuarios/{userId} {
      allow read, create, update, delete:
          if logado() && request.auth.uid == userId;
    }

    match /Pets/{petId} {
      allow read, delete: if logado() && ehDonoDoPet(resource.data);
      allow create: if logado()
          && request.resource.data.userId == request.auth.uid;
      // O pet continua sendo do mesmo tutor depois do update: não dá para
      // transferir para outra conta.
      allow update: if logado()
          && ehDonoDoPet(resource.data)
          && ehDonoDoPet(request.resource.data);

      function pet() {
        return get(/databases/$(database)/documents/Pets/$(petId));
      }
      function situacaoAntes() {
        return pet().data.get('situacao', 'ATIVO');
      }
      function situacaoDepois() {
        return getAfter(/databases/$(database)/documents/Pets/$(petId))
            .data.get('situacao', 'ATIVO');
      }
      function donoDoPet() {
        return logado() && ehDonoDoPet(pet().data);
      }
      // O pet existe antes desta escrita (`donoDoPet` lê o estado anterior)
      // e não existe depois, ou seja, é apagado nela (lote do app).
      function apagandoOPet() {
        return !existsAfter(/databases/$(database)/documents/Pets/$(petId));
      }
      // Escrita clínica = criar ou alterar vacina, consulta, histórico ou
      // localização. Bloqueada para pet falecido (ADR 0002).
      function podeEscreverClinico() {
        return donoDoPet() && situacaoAntes() != 'FALECIDO';
      }

      match /vacinas/{id} {
        allow read, delete: if donoDoPet();
        allow create, update: if podeEscreverClinico();
      }
      match /consultas/{id} {
        allow read, delete: if donoDoPet();
        allow create, update: if podeEscreverClinico();
      }
      match /historicoMedico/{id} {
        allow read, delete: if donoDoPet();
        allow create, update: if podeEscreverClinico();
      }
      match /localizacoes/{id} {
        allow read, delete: if donoDoPet();
        allow create, update: if podeEscreverClinico();
      }

      // Galeria de fotos (docs/features/galeria-fotos-pet.md). Só o dono,
      // também com o pet no Memorial (foto não é registro clínico). O
      // registro nasce com o vínculo ao pet e ao autor e o horário do
      // servidor, aponta para uma imagem do Cloudinary e não é editado
      // nesta versão; o dono pode excluir.
      match /fotos/{fotoId} {
        allow read, delete: if donoDoPet();
        allow create: if donoDoPet()
            && request.resource.data.keys().hasOnly([
                'petId', 'userId', 'url', 'publicId', 'largura', 'altura',
                'legenda', 'criadoEm'])
            && request.resource.data.keys().hasAll([
                'petId', 'userId', 'url', 'publicId', 'criadoEm'])
            && request.resource.data.petId == petId
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.url is string
            && request.resource.data.url.size() <= 500
            && request.resource.data.url.matches(
                'https://res[.]cloudinary[.]com/[A-Za-z0-9_-]+/image/upload/.+')
            && request.resource.data.publicId is string
            && request.resource.data.publicId.size() > 0
            && request.resource.data.publicId.size() <= 300
            && (!('legenda' in request.resource.data)
                || (request.resource.data.legenda is string
                    && request.resource.data.legenda.size() <= 300))
            && (!('largura' in request.resource.data)
                || request.resource.data.largura is int)
            && (!('altura' in request.resource.data)
                || request.resource.data.altura is int)
            && request.resource.data.criadoEm == request.time;
        allow update: if false;
      }

      // Cartão de Emergência (issue #41, docs/features/cartao-emergencia.md).
      // Um documento por pet (`cartao`), privado: só o dono lê. Escreve só
      // com o pet ativo (é dado clínico, como vacinas). Cada gravação sobe a
      // `revisao` em 1, então duas edições a partir da mesma versão não se
      // sobrescrevem em silêncio. O que as regras não conseguem conferir
      // (cada item das listas) o app valida antes de gravar.
      match /emergencia/{docId} {
        allow read, delete: if donoDoPet() && docId == 'cartao';
        allow create: if podeEscreverClinico()
            && docId == 'cartao'
            && cartaoValido(request.resource.data)
            && request.resource.data.revisao == 1;
        allow update: if podeEscreverClinico()
            && docId == 'cartao'
            && cartaoValido(request.resource.data)
            && request.resource.data.revisao == resource.data.revisao + 1;
      }

      function situacaoDaLista(valor) {
        return valor in ['NAO_INFORMADO', 'NENHUMA_DECLARADA', 'INFORMADA'];
      }
      function textoAte(valor, maximo) {
        return valor is string && valor.size() <= maximo;
      }
      function cartaoValido(d) {
        return d.keys().hasOnly([
                'versaoEsquema', 'situacaoAlergias', 'alergias',
                'situacaoMedicamentos', 'medicamentos', 'situacaoCondicoes',
                'condicoes', 'tipoSanguineo', 'tipoSanguineoConfirmado',
                'observacoes', 'veterinario', 'mostrarContatoDoTutor',
                'revisao', 'atualizadoEm'])
            && d.keys().hasAll(['versaoEsquema', 'revisao', 'atualizadoEm'])
            && d.versaoEsquema == 1
            && d.revisao is int
            && d.atualizadoEm == request.time
            && situacaoDaLista(d.get('situacaoAlergias', 'NAO_INFORMADO'))
            && situacaoDaLista(d.get('situacaoMedicamentos', 'NAO_INFORMADO'))
            && situacaoDaLista(d.get('situacaoCondicoes', 'NAO_INFORMADO'))
            && d.get('alergias', []) is list
            && d.get('alergias', []).size() <= 20
            && d.get('medicamentos', []) is list
            && d.get('medicamentos', []).size() <= 20
            && d.get('condicoes', []) is list
            && d.get('condicoes', []).size() <= 20
            && textoAte(d.get('tipoSanguineo', ''), 40)
            && d.get('tipoSanguineoConfirmado', false) is bool
            && textoAte(d.get('observacoes', ''), 1000)
            && d.get('mostrarContatoDoTutor', true) is bool
            && d.get('veterinario', {}) is map
            && d.get('veterinario', {}).keys()
                .hasOnly(['nome', 'clinica', 'telefone'])
            && textoAte(d.get('veterinario', {}).get('nome', ''), 80)
            && textoAte(d.get('veterinario', {}).get('clinica', ''), 80)
            && textoAte(d.get('veterinario', {}).get('telefone', ''), 20);
      }

      // Auditoria das mudanças de situação (Memorial). O evento só é aceito
      // na mesma escrita que muda `situacao` do pet, descrevendo exatamente
      // essa mudança, com o próprio usuário como autor e o horário do
      // servidor. Nunca é alterado. Só é apagado pelo dono (LGPD, RF09), no
      // mesmo lote que apaga o pet (exclusão do pet) ou o perfil dele
      // (exclusão de conta). Limite conhecido: o dono ainda pode mudar
      // `situacao` sem evento (update direto); auditoria à prova do próprio
      // dono exigiria servidor.
      match /eventosSituacao/{id} {
        allow read: if donoDoPet();
        allow create: if donoDoPet()
            && request.resource.data.keys().hasOnly([
                'atorId', 'situacaoAnterior', 'situacaoNova', 'motivo',
                'resultado', 'origem', 'em'])
            && request.resource.data.atorId == request.auth.uid
            && request.resource.data.em == request.time
            && request.resource.data.situacaoAnterior == situacaoAntes()
            && request.resource.data.situacaoNova == situacaoDepois()
            && situacaoAntes() != situacaoDepois();
        // O perfil vem primeiro: no lote da exclusão de conta, as duas
        // leituras dele são as mesmas para todos os pets, e o `||` para ali.
        allow delete: if donoDoPet()
            && (apagandoOProprioPerfil() || apagandoOPet());
        allow update: if false;
      }
    }

    // Coleção raiz legada (95 registros históricos já migrados para o
    // MongoDB). Escrita fechada desde a FASE 11; leitura mantida para quem
    // está logado. Fechar a leitura é decisão pendente (ver doc acima).
    match /Localizacoes/{docId} {
      allow read: if logado();
      allow write: if false;
    }
  }
}
