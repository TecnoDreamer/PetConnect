<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: a splash é do próprio sistema (API SplashScreen) e não
         pode ser removida; aqui ela só é personalizada com a cor e o logo
         do PetConnect, em vez do ícone padrão. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_fundo</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
