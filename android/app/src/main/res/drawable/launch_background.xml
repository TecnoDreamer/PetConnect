<?xml version="1.0" encoding="utf-8"?>
<!-- Splash nativa até o Android 11 (do 12 em diante, ver values-v31). Mesma
     cor e mesmo logo, na mesma posição, da SplashScreen do Flutter que vem
     logo depois. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_fundo" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
